digraph {
	labelloc="t";
	label="github.com/samlitowitz/godepvis/examples/simple";
	rankdir="TB";
	node [shape="rect"];

	subgraph "cluster_pkg_a" {
		label="a";
		style="filled";
		fontcolor="#aed1e6";
		fillcolor="#cfe8ef";

		"pkg_a_file_a" [label="a.go", style="filled", fontcolor="#a0c4e2", fillcolor="#c6dbf0"];
	};

	subgraph "cluster_pkg_b" {
		label="b";
		style="filled";
		fontcolor="#aed1e6";
		fillcolor="#cfe8ef";

		"pkg_b_file_b" [label="b.go", style="filled", fontcolor="#a0c4e2", fillcolor="#c6dbf0"];
	};

	subgraph "cluster_pkg_main" {
		label="main";
		style="filled";
		fontcolor="#aed1e6";
		fillcolor="#cfe8ef";

		"pkg_main_file_main" [label="main.go", style="filled", fontcolor="#a0c4e2", fillcolor="#c6dbf0"];
	};

}
